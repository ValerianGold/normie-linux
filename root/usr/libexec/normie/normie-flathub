#!/bin/bash
# normie-flathub: add the Flathub app store (system-wide) so the software center can find
# popular apps such as Chrome, Steam, Discord and VLC. Runs at boot from
# normie-flathub.service until it succeeds once, then never again. Safe to run repeatedly.
STATE=/var/lib/normie
URL=https://dl.flathub.org/repo/flathub.flatpakrepo
TRIES=6
PAUSE=20
if [ "${NORMIE_TEST:-0}" = 1 ]; then STATE="${NORMIE_STATE:-$STATE}"; PAUSE=0; fi

done_ok() { mkdir -p "$STATE" && touch "$STATE/flathub-done"; }

command -v flatpak >/dev/null 2>&1 || { echo "flatpak is not installed"; exit 1; }
if flatpak remotes --system --columns=name 2>/dev/null | grep -qx flathub; then done_ok; exit 0; fi

for _ in $(seq 1 "$TRIES"); do
	if flatpak remote-add --system --if-not-exists flathub "$URL"; then
		done_ok; echo "Flathub added"; exit 0
	fi
	sleep "$PAUSE"
done
echo "Could not reach Flathub; will try again at the next start"
exit 1
