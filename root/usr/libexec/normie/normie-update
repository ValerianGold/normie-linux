#!/bin/bash
# Normie Linux: Update & Repair (backend).  Normally started by the Update & Repair
# window through pkexec, which asks for the administrator password once.
#
#   normie-update                 full update and repair
#   normie-update --only gpu      just check/install graphics drivers
#   normie-update --dry-run       show what would happen, change nothing (no root needed)
#
# Output is "KIND|text" lines for the window to read (PROGRESS, INFO, WARN, DRY, MOK,
# NEEDS_REBOOT, RESULT); anything else is raw command output for the details log.
# Design and safety notes: docs/UPDATE-AND-REPAIR.md
set -u

# Fixed paths. The test suite can override them, but ONLY with NORMIE_TEST=1 (pkexec and
# sudo also clear the environment, so an ordinary user cannot redirect a root script).
LIBEXEC=/usr/libexec/normie
CONF=/etc/normie/update.conf
LOG=/var/log/normie-update.log
STATE=/var/lib/normie
if [ "${NORMIE_TEST:-0}" = 1 ]; then
	LIBEXEC="${NORMIE_LIBEXEC:-$LIBEXEC}"; CONF="${NORMIE_CONF:-$CONF}"; LOG="${NORMIE_LOG:-$LOG}"
	STATE="${NORMIE_STATE:-$STATE}"
fi
DRY=0
ONLY=all
while [ $# -gt 0 ]; do
	case "$1" in
		--dry-run) DRY=1 ;;
		--only) ONLY="${2:-all}"; shift ;;
		--gui) ;;
	esac
	shift
done
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
DEPS_LIST_URL="${DEPS_LIST_URL:-}"
# shellcheck disable=SC1091
. "$LIBEXEC/normie-lib.sh"

touch "$LOG" 2>/dev/null || LOG="/tmp/normie-update.log"

say() { printf '%s|%s\n' "$1" "$2" | tee -a "$LOG"; }

run() {  # run a command, logging its output; in dry-run mode only print it
	if [ "$DRY" = 1 ]; then say DRY "$*"; return 0; fi
	"$@" 2>&1 | tee -a "$LOG"
	return "${PIPESTATUS[0]}"
}

is_live() {
	[ "${NORMIE_TEST:-0}" = 1 ] && [ -n "${NORMIE_FORCE_LIVE:-}" ] && return 0
	[ -e /run/initramfs/livedev ] || grep -qw rd.live.image /proc/cmdline 2>/dev/null
}
is_root() {
	if [ "${NORMIE_TEST:-0}" = 1 ] && [ -n "${NORMIE_FAKE_ROOT:-}" ]; then [ "$NORMIE_FAKE_ROOT" = 1 ]; return; fi
	[ "$(id -u)" -eq 0 ]
}

FAILED=()
fail() { FAILED+=("$1"); say WARN "$2"; }

# ------------------------------------------------------------------ steps
s_net() {
	if [ "$DRY" = 1 ]; then say DRY "check internet connection"; return 0; fi
	if curl -fsS --max-time 15 -o /dev/null https://fedoraproject.org/ 2>/dev/null; then return 0; fi
	say WARN "No internet connection. Connect to the internet and try again."
	return 1
}

s_repos() {  # Flathub, RPM Fusion (free, nonfree, tainted) and their AppStream data
	local args=()
	[ "$DRY" = 1 ] && args+=(--dry-run)
	"$LIBEXEC/normie-sources" "${args[@]}" 2>&1 | tee -a "$LOG"
	[ "${PIPESTATUS[0]}" -eq 0 ] || fail repos "Some software sources could not be set up."
}

s_deps() {  # install any newly listed compatibility libraries (data only, never code)
	if [ -z "$DEPS_LIST_URL" ]; then say INFO "No online dependency list configured; skipping."; return 0; fi
	case "$DEPS_LIST_URL" in https://*) ;; *) fail deps "Dependency list must use https://. Skipping."; return 0 ;; esac
	if [ "$DRY" = 1 ]; then say DRY "download $DEPS_LIST_URL and install the packages it lists"; return 0; fi
	local list rc valid=()
	list="$(mktemp)"
	normie_fetch_list "$DEPS_LIST_URL" "$list"; rc=$?
	[ "$NORMIE_LIST_INVALID" -gt 0 ] && say WARN "Ignoring $NORMIE_LIST_INVALID invalid line(s) in the dependency list."
	case "$rc" in
		0) ;;
		1) rm -f "$list"; fail deps "Could not download the dependency list. Skipping."; return 0 ;;
		*) rm -f "$list"; fail deps "The dependency list looked wrong. Skipping."; return 0 ;;
	esac
	mapfile -t valid < "$list"
	say INFO "Checking ${#valid[@]} compatibility libraries"
	if run dnf install -y --skip-unavailable "${valid[@]}"; then
		# remember WHICH version of the list is applied, so the reminder can tell when a newer one exists
		mkdir -p "$STATE" && normie_list_hash "$list" > "$STATE/deps-applied" && chmod 644 "$STATE/deps-applied"
	else
		fail deps "Some compatibility libraries could not be installed."
	fi
	rm -f "$list"
}

s_upgrade() {
	run dnf upgrade --refresh -y || { fail upgrade "The system update did not finish."; return 1; }
}

s_flatpak() {
	if ! command -v flatpak >/dev/null 2>&1; then say INFO "Flatpak not installed; skipping."; return 0; fi
	run flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
		|| say WARN "Could not add the Flathub app store; will try again next time."
	run flatpak update -y --noninteractive || fail flatpak "Some apps could not be updated."
}

on_ac() {  # true on a desktop, or a laptop that is plugged in
	local dir="${NORMIE_POWER:-/sys/class/power_supply}" d have_mains=0 online=0
	[ "${NORMIE_TEST:-0}" = 1 ] || dir=/sys/class/power_supply
	for d in "$dir"/*; do
		[ -r "$d/type" ] || continue
		if [ "$(cat "$d/type")" = Mains ]; then have_mains=1; [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && online=1; fi
	done
	[ "$have_mains" -eq 0 ] && return 0     # no battery/mains info (desktop or VM): assume plugged in
	[ "$online" -eq 1 ]
}

s_firmware() {  # firmware cannot be rolled back by a snapshot, so it is opt-in (see update.conf)
	if [ "${FIRMWARE:-no}" != yes ]; then say INFO "Firmware updates are off (FIRMWARE=yes in /etc/normie/update.conf turns them on)."; return 0; fi
	if ! command -v fwupdmgr >/dev/null 2>&1; then say INFO "fwupd not installed; skipping firmware."; return 0; fi
	if ! on_ac; then say INFO "Skipping firmware updates while on battery power."; return 0; fi
	run fwupdmgr refresh --force >/dev/null 2>&1
	run fwupdmgr update -y --no-reboot-check
	local rc=$?
	# fwupdmgr exits 2 when there is simply nothing to update
	[ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || fail firmware "Some firmware updates did not finish."
	[ "$DRY" = 1 ] || say INFO "Firmware updates are applied during the next restart."
}

s_gpu() {
	local args=(apply) rc
	[ "$DRY" = 1 ] && args+=(--dry-run)
	"$LIBEXEC/normie-gpu" "${args[@]}" 2>&1 | tee -a "$LOG"
	rc="${PIPESTATUS[0]}"
	[ "$rc" -eq 0 ] || fail gpu "Graphics driver setup did not finish."
}

s_finish() {
	run dnf clean packages >/dev/null 2>&1
	if [ "$DRY" != 1 ]; then
		local latest
		latest="$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' 2>/dev/null | sort -V | tail -1)"
		if [ -n "$latest" ] && [ "$latest" != "$(uname -r)" ]; then
			say NEEDS_REBOOT "A new version of Linux was installed"
		fi
	fi
}

# ------------------------------------------------------------------ main
if is_live && [ "$DRY" != 1 ]; then
	say WARN "This is the live session. Install Normie Linux first; updates apply to the installed system."
	say RESULT "failed|live session"; exit 1
fi
if [ "$DRY" != 1 ] && ! is_root; then
	say WARN "Update & Repair needs administrator rights."
	say RESULT "failed|not root"; exit 1
fi

BUILD_INFO=/usr/share/normie/build-info
[ "${NORMIE_TEST:-0}" = 1 ] && BUILD_INFO="${NORMIE_BUILD_INFO:-$BUILD_INFO}"
if [ -r "$BUILD_INFO" ]; then
	say INFO "This is Normie Linux build $(sed -n 's/^NORMIE_BUILD_COMMIT=//p' "$BUILD_INFO") of $(sed -n 's/^NORMIE_BUILD_DATE=//p' "$BUILD_INFO")"
fi

case "$ONLY" in
	gpu) STEPS=(net:"Checking your connection" repos:"Setting up software sources" gpu:"Checking graphics drivers" finish:"Finishing up") ;;
	*)   STEPS=(net:"Checking your connection" repos:"Setting up software sources"
	            deps:"Adding any missing compatibility libraries" upgrade:"Updating your system"
	            flatpak:"Updating your apps" firmware:"Checking for firmware updates"
	            gpu:"Checking graphics drivers" finish:"Finishing up") ;;
esac

total=${#STEPS[@]}
i=0
for entry in "${STEPS[@]}"; do
	name="${entry%%:*}"; label="${entry#*:}"
	say PROGRESS "$(( i * 100 / total ))|$label"
	"s_$name"
	rc=$?
	if [ "$name" = net ] && [ "$rc" -ne 0 ]; then say RESULT "failed|no internet"; exit 1; fi
	i=$(( i + 1 ))
done
say PROGRESS "100|Done"

if [ "${#FAILED[@]}" -eq 0 ]; then
	if [ "$DRY" != 1 ] && [ "$ONLY" = all ]; then  # the reminder reads this
		mkdir -p "$STATE" && date +%s > "$STATE/last-update" && chmod 644 "$STATE/last-update"
	fi
	say RESULT "ok|everything is up to date"
	exit 0
fi
say RESULT "partial|some steps had problems: ${FAILED[*]}"
exit 1
