# Normie Linux's own packages: the release files, logos, wallpaper, Plasma look and, later, the tools.
# Update & Repair installs their updates like any others. Hosted on Copr, which signs every package.
# Filled in by tools/set-copr-user.sh.
[normie]
name=Normie Linux own packages
baseurl=https://download.copr.fedorainfracloud.org/results/valeriangold/normie-linux/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/valeriangold/normie-linux/pubkey.gpg
repo_gpgcheck=0
enabled=1
