[Unit]
Description=Set up extra software sources: Flathub and RPM Fusion (Normie Linux)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/normie/sources-done

[Service]
# Type=simple so a slow or missing network can never delay the login screen
Type=simple
ExecStart=/usr/libexec/normie/normie-sources

[Install]
WantedBy=multi-user.target
