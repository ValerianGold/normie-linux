<!--
  Normie Linux dependency set (profile: NormieFull).

  STATUS: carried over unchanged from the first prototype. NOT YET VERIFIED.
  Before building Normie-Full-Live, run on the build host:
      python3 tools/check-packages.py
  One non-existent package name fails the whole build, so fix every name it
  reports first. Open questions about these lists are tracked in docs/DECISIONS.md.

  Long-term plan: this list moves into an installed RPM metapackage
  ("normie-deps") so the Update & Repair button can keep dependencies
  current after install. The XML here then shrinks to a few package names.
-->
<image>

	<!-- ===== Core libraries and AppImage support (64-bit) =====
	     fuse-libs provides libfuse.so.2, which AppImages need.
	-->
	<packages type="image" patternType="plusRecommended" profiles="NormieFull">
		<package name="openssl"/>
		<package name="openssl-libs"/>
		<package name="gnutls"/>
		<package name="dbus"/>
		<package name="dbus-libs"/>
		<package name="fuse"/>
		<package name="fuse-libs"/>
	</packages>

	<!-- ===== Build tools and -devel headers (64-bit) =====
	     Added for Xodus Nexus. Which of these it REALLY needs at runtime is still
	     unknown - see docs/DECISIONS.md D-4. Kept on purpose (completeness over size).
	-->
	<packages type="image" patternType="plusRecommended" profiles="NormieFull">
		<package name="gcc"/>
		<package name="gcc-c++"/>
		<package name="make"/>
		<package name="cmake"/>
		<package name="openssl-devel"/>
		<package name="dbus-devel"/>
		<package name="pkgconf-pkg-config"/>
	</packages>

